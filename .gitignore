# Environment & secrets
.env
.env.local
.env.*.local
lab.conf
setup.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# Runtime state (generated at setup/run time, never committed)
lab/data/
lab/models/
lab/pkb/inbox/*
!lab/pkb/inbox/.gitkeep
lab/pkb/.wiki-cache/
# PKB sections that agents + docgen write to — re-seed / rebuild on demand.
lab/pkb/agents/
lab/pkb/compiled/
lab/pkb/inference/
lab/pkb/notes/
lab/pkb/research/
lab/pkb/skills/
lab/pkb/sources/seeds/
lab/pkb/index.md
# Open Notebook container runtime state
compose/open-notebook/data/
compose/open-notebook/surreal/
compose/open-notebook/speaches-cache/
*.gguf
*.bin
*.safetensors

# Notebooks
notebooks/*.ipynb
!notebooks/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Sandbox can't unlink certain files; we mv them into .graveyard/ pending
# a human-run `rm -rf .graveyard/` on the host.
.graveyard/

# mypy / pytest
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage
.ipynb_checkpoints/
