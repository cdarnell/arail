  "capabilities": [
    {
      "id": "speech-to-text",
      "purpose": "Transcribe spoken observations into the lab knowledge base.",
      "desired": true,
      "interface": { "inputs": ["audio"], "outputs": ["transcript", "segments", "confidence"] }
    },
    {
      "id": "equation-ocr",
      "purpose": "Recognize printed text and numbers in an image into the lab knowledge base.",
