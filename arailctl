        fi
        export KB_ROOT
        # Common preamble for any Claude invocation
        KB_PB="You are the librarian of the Karpathy-style knowledge base at \$KB_ROOT.
Read AGENTS.md FIRST — it explains the philosophy, structure, and your job.
Read tools/librarian/PROMPT.md SECOND — your detailed operating spec.
The wiki is the compiled artifact; raw/ is the input. Always preserve provenance
in _SOURCES.md and update _INDEX.md when you add or rename pages.
Use [[wikilinks]] for every cross-reference. Be precise; this knowledge compounds."
        kb_claude() {
            command -v claude >/dev/null 2>&1 || die "'claude' CLI not found. npm install -g @anthropic-ai/claude-code"
            ( cd "$KB_ROOT" && claude --allowedTools "Bash,Read,Write,Edit,Glob,Grep" "$@" )
        }
        case "$kb_op" in
            where)
                echo "$KB_ROOT"
                ;;
            help|-h|--help)
                kb_usage "$KB_ROOT"
                ;;
            status)
                cd "$KB_ROOT"
                raw_n=$(find raw -type f 2>/dev/null | wc -l | tr -d ' ')
                wiki_n=$(find wiki -name '*.md' -not -path 'wiki/.obsidian/*' 2>/dev/null | wc -l | tr -d ' ')
                con_n=$(find wiki/concepts -name '*.md' 2>/dev/null | wc -l | tr -d ' ')
                adr_n=$(find wiki/adrs -name '*.md' 2>/dev/null | wc -l | tr -d ' ')
                pap_n=$(find wiki/papers -name '*.md' 2>/dev/null | wc -l | tr -d ' ')
                last=$([ -f .last_compile ] && cat .last_compile || echo "never")
                printf "KB root      : %s\n" "$KB_ROOT"
                printf "Raw sources  : %s\n" "$raw_n"
                printf "Wiki pages   : %s  (concepts=%s adrs=%s papers=%s)\n" "$wiki_n" "$con_n" "$adr_n" "$pap_n"
                printf "Last compile : %s\n" "$last"
                if [[ -f wiki/_INDEX.md ]]; then
                    reported=$(grep -oE 'Wiki articles: *[0-9]+' wiki/_INDEX.md | head -1 | grep -oE '[0-9]+' || echo "?")
                    echo
                    echo "_INDEX.md reports $reported wiki articles; disk has $wiki_n."
                    [[ "$reported" != "$wiki_n" ]] && echo "  → drift detected. Run: qkz kb index"
                fi
                ;;
            compile)
                cd "$KB_ROOT"
                date +%Y-%m-%dT%H:%M:%S > .last_compile
                case "${1:-}" in
                    ""|incremental)
                        kb_claude "$KB_PB

TASK: Incremental wiki compile.
1) List raw/ files not yet referenced in wiki/_SOURCES.md.
2) For each, follow tools/librarian/PROMPT.md to extract atomic concepts and write/update wiki pages.
3) Update _INDEX.md and _SOURCES.md.
4) Verify all new [[wikilinks]] resolve.
5) Report: files processed, pages created/updated, broken links remaining."
                        ;;
                    all|--full|full)
                        kb_claude "$KB_PB

