        ;;
    kb)
        # QuKaiZen Karpathy LLM Wiki ops. KB root is discovered, never hardcoded.
        kb_op="${1:-help}"; shift || true
        # `help` works without KB discovery — it's general info.
        if [[ "$kb_op" == "help" || "$kb_op" == "-h" || "$kb_op" == "--help" ]]; then
            kb_usage
            exit 0
        fi
        if ! KB_ROOT="$(discover_kb_root)"; then
            die "no QuKaiZen knowledge base found.
