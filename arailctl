Write your page here. Link other pages with [[double-brackets]].
Tags inline with #hashtag are also picked up.
TEMPLATE
                say "created: $dest"
                ;;
            *) die "wiki op must be one of: build | info | new <title> | serve" ;;
        esac
        ;;
    benchmark_models|benchmark|aerollm)
        [[ -d .venv ]] || die "missing .venv — run ./arailctl setup"
        # shellcheck disable=SC1091
        source .venv/bin/activate
        # Default to --all if no args given
        if [[ $# -eq 0 ]]; then
            set -- --all
        fi
        exec python "$REPO_ROOT/lab/tools/benchmark_models.py" "$@"
        ;;
    kb)
        # QuKaiZen Karpathy LLM Wiki ops. KB root is discovered, never hardcoded.
        kb_op="${1:-help}"; shift || true
        # `help` works without KB discovery — it's general info.
        if [[ "$kb_op" == "help" || "$kb_op" == "-h" || "$kb_op" == "--help" ]]; then
            cat <<KBHELP

  qkz kb — QuKaiZen Karpathy LLM Wiki

    qkz kb status                Counts, drift, last compile
    qkz kb compile               Incremental: only new raw/ files
    qkz kb compile all           Full recompile from raw/
    qkz kb compile <file>        One specific raw/ file
    qkz kb lint                  Heuristic health check via Claude
    qkz kb validate [path]       Strict PAGESPEC.md compliance (no Claude)
    qkz kb query "question"      Ask the wiki; writes outputs/<date>_<slug>/
    qkz kb ingest --url|--file|--youtube|--dir ARG
    qkz kb search "term" [--tags X] [--type T] [--wiki|--raw]
    qkz kb index                 Regenerate _INDEX.md from disk
    qkz kb where                 Print discovered KB_ROOT

  KB discovery order:
    1. \$QKZ_KB_ROOT environment variable
    2. Upward search from CWD (looking for AGENTS.md + wiki/_INDEX.md)
    3. \$HOME/{ProJects,projects,Projects}/knowledge_base
    4. \$HOME/knowledge_base
  No hardcoded paths.
  Schema: \$KB_ROOT/PAGESPEC.md is the single source of truth for page format.
  Read \$KB_ROOT/AGENTS.md to understand why this beats RAG.

KBHELP
            exit 0
        fi
        if ! KB_ROOT="$(discover_kb_root)"; then
            die "no QuKaiZen knowledge base found.
  Tried: \$QKZ_KB_ROOT, upward search from $INVOCATION_PWD,
         \$HOME/{ProJects,projects,Projects}/knowledge_base, \$HOME/knowledge_base.
  Fix:   export QKZ_KB_ROOT=/path/to/your/knowledge_base
         (or run \`qkz kb\` from inside a KB directory)"
        fi
        export KB_ROOT
        # Common preamble for any Claude invocation
        KB_PB="You are the librarian of the Karpathy-style knowledge base at \$KB_ROOT.
Read AGENTS.md FIRST — it explains the philosophy, structure, and your job.
Read tools/librarian/PROMPT.md SECOND — your detailed operating spec.
The wiki is the compiled artifact; raw/ is the input. Always preserve provenance
in _SOURCES.md and update _INDEX.md when you add or rename pages.
Use [[wikilinks]] for every cross-reference. Be precise; this knowledge compounds."
        kb_claude() {
            command -v claude >/dev/null 2>&1 || die "'claude' CLI not found. npm install -g @anthropic-ai/claude-code"
            ( cd "$KB_ROOT" && claude --allowedTools "Bash,Read,Write,Edit,Glob,Grep" "$@" )
        }
        case "$kb_op" in
            where)
                echo "$KB_ROOT"
                ;;
            help|-h|--help)
