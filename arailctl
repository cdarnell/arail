#!/usr/bin/env bash
# =============================================================================
#  arail / qkz — unified entry point for ARAIL + QuKaiZen knowledge base
#  Usage: ./arailctl <command> [args]   (or: qkz <command> [args])
#    setup    first-time provisioning — pick a tier, install deps, download model
#    start    launch portal + terminal + notebook + IDE
#             (or a single World instance: --world <slug> — see `start --help`)
#    stop     stop running lab services
#    restart  stop then start
#    upgrade  switch install tier — minimalist | maximus
#    update   check for and apply component updates
#    version  show installed component versions
#    reset    wipe models/data/env/plugins (see: ./arailctl reset help)
#    status   show what's running and where
#    doctor   validate the environment end-to-end
#    logs     tail activity log — filter by component
#    pkb      ARAIL knowledge base ops (lab content): ingest | compile | browse
#    wiki     ARAIL documentation-as-code: build | info | new <title>
#    kb       QuKaiZen Karpathy LLM Wiki ops: status | compile | lint | query |
#             search | ingest | index | where  (discoverable, no hardcoded paths)
#    help     show this message
#
#  Discoverability:
#    REPO_ROOT (ARAIL repo)  resolved by walking the symlink chain — works
#                            whether invoked as ./arailctl, ./qkz, ~/.local/bin/qkz,
#                            or any other shim.
#    KB_ROOT  (QuKaiZen KB)  resolved on demand by `kb` subcommand:
#                            $QKZ_KB_ROOT  →  upward search from CWD  →
#                            $HOME/{ProJects,projects}/knowledge_base  →
#                            $HOME/knowledge_base  →  helpful error.
# =============================================================================
set -euo pipefail

# Resolve symlinks so REPO_ROOT points to the real repo even when this
# script is invoked through a shim like ~/bin/arail or ~/.local/bin/arail.
# macOS ships bash 3.2 which lacks `readlink -f`, so walk the chain
# manually — POSIX-portable and zero deps.
_arail_self="${BASH_SOURCE[0]}"
while [[ -L "$_arail_self" ]]; do
    _arail_link="$(readlink "$_arail_self")"
    if [[ "$_arail_link" = /* ]]; then
        _arail_self="$_arail_link"
    else
        _arail_self="$(cd "$(dirname "$_arail_self")" && pwd)/$_arail_link"
    fi
done
REPO_ROOT="$(cd "$(dirname "$_arail_self")" && pwd)"
# Export so `exec bash scripts/<sub>.sh` children see it. Subscripts
# reference $REPO_ROOT directly (e.g. setup.sh:install_path_shim) and
# would crash under `set -u` without this.
export REPO_ROOT
unset _arail_self _arail_link

# scripts/lib/instances.sh is THE single source of truth for daemon
# liveness and the World-instance registry (see
# sprints/2026-07-28-concurrent-worlds/ARCHITECTURE.md §2.6). Sourced here
# so daemon_active() replaces the old file-existence-only daemon_installed().
# shellcheck disable=SC1091
source "$REPO_ROOT/scripts/lib/instances.sh"
# Remember where the user actually invoked us — needed by `kb`'s upward search
# so that running `qkz kb status` from inside the KB Just Works.
INVOCATION_PWD="$PWD"
export INVOCATION_PWD
cd "$REPO_ROOT"

# ---------------------------------------------------------------------------
# QuKaiZen KB discovery (used by the `kb` subcommand only — lazy)
# Order: $QKZ_KB_ROOT → upward search from CWD → standard locations → fail.
# A KB root is a directory containing both AGENTS.md and wiki/_INDEX.md.
# ---------------------------------------------------------------------------
discover_kb_root() {
    local d
    if [[ -n "${QKZ_KB_ROOT:-}" && -f "$QKZ_KB_ROOT/AGENTS.md" && -f "$QKZ_KB_ROOT/wiki/_INDEX.md" ]]; then
        echo "$QKZ_KB_ROOT"; return 0
    fi
    # Upward walk from invocation CWD (saved before cd "$REPO_ROOT" — see below)
    d="${INVOCATION_PWD:-$PWD}"
    while [[ "$d" != "/" && -n "$d" ]]; do
        if [[ -f "$d/AGENTS.md" && -f "$d/wiki/_INDEX.md" ]]; then
            echo "$d"; return 0
        fi
        d="$(dirname "$d")"
    done
    # Standard locations — case variants for macOS habits
    local cand
    for cand in \
        "$HOME/ProJects/knowledge_base" \
        "$HOME/projects/knowledge_base" \
        "$HOME/Projects/knowledge_base" \
        "$HOME/knowledge_base"; do
        if [[ -f "$cand/AGENTS.md" && -f "$cand/wiki/_INDEX.md" ]]; then
            echo "$cand"; return 0
        fi
    done
    return 1
}

# kb_usage [<kb_root>] — the ONE `qkz kb help` body, called both before KB_ROOT
# is known (pre-discovery `kb help`) and after (in-case `kb help`, which used
# to be a second, hand-maintained heredoc that had already drifted from this
# one — this one is the complete, current text; ARCHITECTURE.md §13 "duplicate
# kb help heredocs": "Output text preserved (it is user-facing documentation)").
kb_usage() {
    local root="${1:-}"
    cat <<KBUSAGE

  qkz kb — QuKaiZen Karpathy LLM Wiki${root:+ ($root)}

    qkz kb status                Counts, drift, last compile
    qkz kb compile               Incremental: only new raw/ files
    qkz kb compile all           Full recompile from raw/
    qkz kb compile <file>        One specific raw/ file
    qkz kb lint                  Heuristic health check via Claude
    qkz kb validate [path]       Strict PAGESPEC.md compliance (no Claude)
    qkz kb query "question"      Ask the wiki; writes outputs/<date>_<slug>/
    qkz kb ingest --url|--file|--youtube|--dir ARG
    qkz kb search "term" [--tags X] [--type T] [--wiki|--raw]
    qkz kb index                 Regenerate _INDEX.md from disk
    qkz kb where                 Print discovered KB_ROOT

  KB discovery order:
    1. \$QKZ_KB_ROOT environment variable
    2. Upward search from CWD (looking for AGENTS.md + wiki/_INDEX.md)
    3. \$HOME/{ProJects,projects,Projects}/knowledge_base
    4. \$HOME/knowledge_base
  No hardcoded paths.
  Schema: \$KB_ROOT/PAGESPEC.md is the single source of truth for page format.
  Read \$KB_ROOT/AGENTS.md to understand why this beats RAG.

KBUSAGE
}

# Load .env so LAB_NAME / LAB_TAGLINE reach the help banner.
# shellcheck disable=SC1091
[[ -f .env ]] && set -a && source .env && set +a
LAB_NAME="${LAB_NAME:-Autoresearch AI Lab}"
LAB_SHORT_NAME="${LAB_SHORT_NAME:-autoresearch-lab}"
LAB_TAGLINE="${LAB_TAGLINE:-A learn-by-doing AI research lab}"
LAB_TIER="${LAB_TIER:-minimalist}"
# v1.0.0 tier-rename compat shim — accept old min/max values silently.
# Removed in v1.1.0; see CHANGELOG.md.
case "$LAB_TIER" in
    min)  LAB_TIER="minimalist" ;;
    max)  LAB_TIER="maximus"    ;;
esac

# ── ANSI color gating (ARCHITECTURE.md §13 "ANSI leaks into non-tty
# output", F25): auto = colors iff stdout is a tty and NO_COLOR is unset;
# ARAIL_COLOR=always|never overrides both tests. Inlined per-script (not a
# shared lib/tty.sh) — reset.sh is unit-tested as a standalone copy of
# itself (tests/test_reset_paths.py) and must not gain a new `source`
# dependency (the source-<missing-file> landmine class, A2).
# $'...' (ANSI-C quoting), not "..." — a plain double-quoted "\033[1m" is
# the LITERAL 4 characters backslash/0/3/3, not an escape byte; that only
# renders as color through `echo -e`/`printf`'s own escape processing.
# usage()'s heredoc below is plain `cat`, which does no escape processing
# at all, so the variables themselves must already hold real ESC bytes
# (found while wiring ${BOLD}/${RESET} into that heredoc for this sprint —
# setup.sh's capture_tier/capture_mode heredocs have the same latent bug,
# fixed the same way in the same commit).
if [[ -t 1 && "${ARAIL_COLOR:-auto}" != "never" && -z "${NO_COLOR:-}" ]] || [[ "${ARAIL_COLOR:-auto}" == "always" ]]; then
    BOLD=$'\033[1m'; GREEN=$'\033[0;32m'; CYAN=$'\033[0;36m'; YELLOW=$'\033[0;33m'; RED=$'\033[0;31m'; RESET=$'\033[0m'
else
    BOLD=""; GREEN=""; CYAN=""; YELLOW=""; RED=""; RESET=""
fi
say()  { echo -e "${GREEN}[${LAB_SHORT_NAME}]${RESET} $*"; }
warn() { echo -e "${YELLOW}[${LAB_SHORT_NAME}]${RESET} $*"; }
die()  { echo -e "${RED}[${LAB_SHORT_NAME}]${RESET} $*" >&2; exit 1; }

usage() {
    # Detect which form the user invoked us as (arail vs qkz) and whether
    # the script is reachable on PATH (in which case ./ isn't required).
    local invoked
    invoked="$(basename -- "${0:-arail}")"
    local on_path=""
    if command -v "$invoked" >/dev/null 2>&1; then
        local resolved
        resolved="$(command -v "$invoked")"
        # On PATH only if the resolved path isn't the literal ./<name> form.
        if [[ "$resolved" != "./${invoked}" ]]; then
            on_path="$resolved"
        fi
    fi

    local invocation
    if [[ -n "$on_path" ]]; then
        invocation="${invoked} <command> [args]"
    else
        invocation="./${invoked} <command> [args]"
    fi

    cat <<EOF

  ${BOLD}${LAB_NAME}${RESET} — ${LAB_TAGLINE}
  Install tier: ${LAB_TIER}

  Usage: ${invocation}
EOF

    if [[ -n "$on_path" ]]; then
        echo "  Installed at: ${on_path}"
    else
        cat <<EOF
  Repo path:    ${REPO_ROOT}/${invoked}
  Tip:          \`./${invoked} setup\` installs ${invoked} to ~/.local/bin so
                you can call it from any directory afterwards.
EOF
    fi

    cat <<EOF
  In-repo alias: ./qkz is a symlink to ./arailctl (brand-flexible name).
                 The PATH installer skips qkz if you already have one
                 (e.g. a QuKaiZen knowledge-base function); opt in with
                 ARAIL_INSTALL_QKZ=1 ./arailctl setup to override.

  Commands:
    setup           first-time provisioning — pick a tier, deps, model
    start           launch the lab (foreground start.sh, or launchd in daemon mode)
                    [--world <slug>] [--port <n>] [--no-browser] [--list] [--yes]
                    — with 2+ Worlds configured, bare 'start' picks interactively;
                    a running World is attached to, never respawned
    stop            stop lab services (unloads launchd agents in daemon mode)
                    [--world <slug>] [--all] — target one/all World instances
    restart         stop then start (launchctl kickstart -k in daemon mode)
    install-daemon  supervise the lab with launchd — starts at login, respawns on crash
    uninstall-daemon  remove launchd supervision (back to dev/foreground mode)
    upgrade <tier>  switch install tier — minimalist | maximus
    deep <op>       AeroLLM 2nd inference: rebuild (source) | update (wheel) | status
    update          check for and apply component updates
    version         show installed component versions
    status [--json] [--probe]  show what's running (World instances + root lab)
    doctor          validate the environment end-to-end
    logs [comp]     tail activity log — filter by component
    reset [mode]    wipe state — models|data|pkb|plugins|env|full|destroy
    world <op>      DaC WorldBundle: list | mount <dir> [--apply-face] | verify <dir> | verify-shipped [--examples] | swap <dir> | unmount
    pkb <op>        ARAIL lab content: ingest | compile | browse
    wiki <op>       ARAIL docs-as-code: build | info | new <title>
    kb <op>         QuKaiZen Karpathy Wiki: status | compile | lint | query
                    | search | ingest | index | where    (auto-discovers KB root)
    blueprint <op>  list | catalog | show | create | apply | destroy — Configuration as Code
    benchmark_models [opts]  measure model TPS for autoresearch routing (alias: benchmark, aerollm)
    help            this message

EOF

    if [[ -n "$on_path" ]]; then
        echo "  Quick start:   ${invoked} setup && ${invoked} start"
    else
        echo "  Quick start:   ./${invoked} setup && ${invoked} start"
        echo "                 (after setup, ${invoked} is on PATH — ./ no longer needed)"
    fi
    echo ""
}

cmd="${1:-help}"; shift || true

# ── launchd daemon mode ──────────────────────────────────────────────
# When install-daemon has been run AND the daemon is actually loaded and
# running, start/stop/restart drive launchctl instead of the foreground
# start.sh. daemon_active() (scripts/lib/instances.sh) checks BOTH the
# plist file AND a live launchctl PID — a plist that exists but was
# unloaded (e.g. by a prior `./arailctl stop`) no longer routes here, which
# is the fix for the plist-existence trap this sprint retires.
daemon_agents() {
    local label
    for label in io.arail.portal io.arail.memory io.arail.mlx; do
        [[ -f "$HOME/Library/LaunchAgents/$label.plist" ]] && echo "$label"
    done
    return 0
}

case "$cmd" in
    setup)     exec bash "$REPO_ROOT/scripts/setup.sh" "$@" ;;
    blueprint) exec bash "$REPO_ROOT/scripts/blueprint.sh" "$@" ;;
    install-daemon)   exec bash "$REPO_ROOT/scripts/install-daemon.sh" ;;
    uninstall-daemon) exec bash "$REPO_ROOT/scripts/install-daemon.sh" --uninstall ;;
    start)
        # B2 fix: --world/--list/--help must ALWAYS reach start.sh, even
        # when the daemon is active — start.sh itself owns the daemon-mode
        # refusal (naming the World slug when one was requested, F8) and
        # the --list/--help paths are side-effect-free and must work
        # regardless of daemon state. Silently discarding argv in this
        # branch was the exact bug this sprint set out to fix, re-created
        # one level up (ARCHITECTURE.md §3.1) — see REVIEW.md B2.
        _arail_start_forwards_argv=0
        for _arail_start_arg in "$@"; do
            case "$_arail_start_arg" in
                --world|--world=*|--list|-h|--help) _arail_start_forwards_argv=1; break ;;
            esac
        done
        if [[ "$_arail_start_forwards_argv" == "1" ]]; then
            unset _arail_start_forwards_argv _arail_start_arg
            exec bash "$REPO_ROOT/scripts/start.sh" "$@"
        fi
        unset _arail_start_forwards_argv _arail_start_arg
        if daemon_active; then
            for label in $(daemon_agents); do
                launchctl load "$HOME/Library/LaunchAgents/$label.plist" 2>/dev/null || true
            done
            launchctl kickstart "gui/$(id -u)/io.arail.portal" 2>/dev/null || true
            # Ports live in lab.conf (setup picks free ones), NOT .env —
            # source both, in the same order as start.sh/status.sh, or we
            # print a default port the lab isn't actually on.
            # shellcheck disable=SC1091
            [[ -f "$REPO_ROOT/.env" ]] && set -a && source "$REPO_ROOT/.env" && set +a
            if [[ -f "$REPO_ROOT/lab.conf" ]]; then
                # shellcheck disable=SC1091
                set -a && source "$REPO_ROOT/lab.conf" && set +a
            fi
            echo "Lab supervised by launchd — portal: http://${BIND_ADDR:-127.0.0.1}:${PORTAL_PORT:-8080}"
            exit 0
        fi
        exec bash "$REPO_ROOT/scripts/start.sh" "$@"
        ;;
    stop)
        # --world/--all target a specific World instance (or all of them) —
        # orthogonal to daemon supervision of the ROOT lab (ARCHITECTURE.md
        # §4.3: stop never unloads plists as a side effect of stopping an
        # instance), so these bypass the daemon branch below entirely.
        if [[ "$*" == *--world* || "$*" == *--all* ]]; then
            exec bash "$REPO_ROOT/scripts/reset.sh" stop "$@"
        fi
        if daemon_active; then
            for label in $(daemon_agents); do
                launchctl unload "$HOME/Library/LaunchAgents/$label.plist" 2>/dev/null || true
            done
            echo "Lab agents unloaded — they stay stopped until ./arailctl start."
            exit 0
        fi
        exec bash "$REPO_ROOT/scripts/reset.sh" stop "$@"
        ;;
    restart)
        if daemon_active; then
            for label in $(daemon_agents); do
                launchctl kickstart -k "gui/$(id -u)/$label" 2>/dev/null || true
            done
            echo "Lab agents restarted (launchctl kickstart -k)."
            exit 0
        fi
        bash "$REPO_ROOT/scripts/reset.sh" stop && exec bash "$REPO_ROOT/scripts/start.sh" "$@" ;;
    upgrade) exec bash "$REPO_ROOT/scripts/upgrade.sh" "$@" ;;
    deep)
        # AeroLLM 2nd-inference: rebuild (source) | update (published wheel) | status.
        op="${1:-status}"; shift || true
        case "$op" in
            rebuild) exec bash "$REPO_ROOT/scripts/build-aerollm.sh" build ;;
            update)  exec bash "$REPO_ROOT/scripts/build-aerollm.sh" update ;;
            status)  exec bash "$REPO_ROOT/scripts/build-aerollm.sh" status ;;
            *) die "deep op must be one of: rebuild | update | status" ;;
        esac
        ;;
    update)  exec bash "$REPO_ROOT/scripts/update.sh" "$@" ;;
    version) exec bash "$REPO_ROOT/scripts/update.sh" --version-only ;;
    reset)   exec bash "$REPO_ROOT/scripts/reset.sh" "$@" ;;
    status)  exec bash "$REPO_ROOT/scripts/status.sh" "$@" ;;
    logs)
        LOG_FILE="$REPO_ROOT/lab/data/activity.jsonl"
        COMP="${1:-all}"; shift || true
        LINES="${1:-50}"; shift || true
        if [[ ! -f "$LOG_FILE" ]]; then
            die "No activity log yet — start the lab first: ./arailctl start"
        fi
        case "$COMP" in
            all)
                say "Tailing all activity (last $LINES lines, Ctrl-C to stop)…"
                echo ""
                tail -n "$LINES" "$LOG_FILE" | python3 -c "
import sys, json
for line in sys.stdin:
    try:
        e = json.loads(line.strip())
        ts = e.get('ts','')[:19].replace('T',' ')
        src = e.get('source','?').ljust(12)
        lvl = e.get('level','info')
        msg = e.get('message','')
        colors = {'info':'\033[0m','success':'\033[0;32m','warn':'\033[0;33m','error':'\033[0;31m'}
        c = colors.get(lvl, '\033[0m')
        print(f'{c}{ts}  {src}  {msg}\033[0m')
    except: pass
"
                echo ""
                say "Live tail:"
                tail -F "$LOG_FILE" | python3 -c "
import sys, json
for line in sys.stdin:
    try:
        e = json.loads(line.strip())
        ts = e.get('ts','')[:19].replace('T',' ')
        src = e.get('source','?').ljust(12)
        lvl = e.get('level','info')
        msg = e.get('message','')
        colors = {'info':'\033[0m','success':'\033[0;32m','warn':'\033[0;33m','error':'\033[0;31m'}
        c = colors.get(lvl, '\033[0m')
        print(f'{c}{ts}  {src}  {msg}\033[0m', flush=True)
    except: pass
"
                ;;
            browser|system|researcher|goal|wiki|pkb|chat|consent)
                say "Tailing $COMP events (last $LINES, Ctrl-C to stop)…"
                echo ""
                grep "\"source\":.*\"$COMP\"" "$LOG_FILE" | tail -n "$LINES" | python3 -c "
import sys, json
for line in sys.stdin:
    try:
        e = json.loads(line.strip())
        ts = e.get('ts','')[:19].replace('T',' ')
        lvl = e.get('level','info')
        msg = e.get('message','')
        colors = {'info':'\033[0m','success':'\033[0;32m','warn':'\033[0;33m','error':'\033[0;31m'}
        c = colors.get(lvl, '\033[0m')
        print(f'{c}{ts}  {msg}\033[0m')
    except: pass
"
                echo ""
                say "Live tail ($COMP only):"
                tail -F "$LOG_FILE" | grep --line-buffered "\"source\":.*\"$COMP\"" | python3 -c "
import sys, json
for line in sys.stdin:
    try:
        e = json.loads(line.strip())
        ts = e.get('ts','')[:19].replace('T',' ')
        lvl = e.get('level','info')
        msg = e.get('message','')
        colors = {'info':'\033[0m','success':'\033[0;32m','warn':'\033[0;33m','error':'\033[0;31m'}
        c = colors.get(lvl, '\033[0m')
        print(f'{c}{ts}  {msg}\033[0m', flush=True)
    except: pass
"
                ;;
            help|-h)
                cat <<LOGSEOF

  Usage: ./arailctl logs [component] [lines]

  Components:
    all          all events (default)
    browser      web research / agent-browser actions
    system       portal startup, mode changes, health
    researcher   research agent — experiments, LLM calls
    goal         goal set/reset events
    wiki         wiki rebuild operations
    pkb          knowledge base ingest, uploads
    chat         chat API calls, inference
    consent      domain approval/denial

  Examples:
    ./arailctl logs                # tail all, last 50
    ./arailctl logs researcher 100 # last 100 researcher events

LOGSEOF
                ;;
            *)
                die "Unknown component: $COMP — run ./arailctl logs help for options"
                ;;
        esac
        ;;
    doctor)
        # Exit-code contract (ARCHITECTURE.md §12/§13): 0 healthy · 1 broken
        # (no .venv, import failure) · 3 degraded (a required check failed,
        # or --strict promoted an optional/info finding). CI
        # (.github/workflows/blueprint-smoke.yml:206) runs this under
        # `set -euo pipefail` on a runner that legitimately lacks ttyd,
        # code-server, and any pulled model (A8) — those stay INFO-only
        # (never degrade) unless --strict is passed, so the smoke job keeps
        # exiting 0.
        _doctor_strict=0
        for _doctor_arg in "$@"; do
            case "$_doctor_arg" in
                --strict) _doctor_strict=1 ;;
            esac
        done
        say "Checking environment…"
        [[ -d .venv ]] || { warn "missing .venv — run ./arailctl setup"; exit 1; }
        # shellcheck disable=SC1091
        source .venv/bin/activate
        python -c "import arail; from arail.portal.app import app; from arail.pkb import _pkb_root; print('python: OK'); print('pkb root:', _pkb_root())" \
            || die "import check failed"

        # Findings tally: a required check failing sets _doctor_degraded;
        # an optional (INFO) one only does under --strict. Replaces the old
        # single-item `for bin in uvicorn` loop (ARCHITECTURE.md §13) — its
        # disappearance and the exit contract are the same edit.
        _doctor_degraded=0
        if command -v uvicorn >/dev/null 2>&1; then
            :
        else
            warn "missing: uvicorn"
            _doctor_degraded=1
        fi
        for bin in jupyter ttyd code-server; do
            if ! command -v "$bin" >/dev/null 2>&1; then
                warn "optional missing: $bin"
                [[ "$_doctor_strict" == "1" ]] && _doctor_degraded=1
            fi
        done

        # Full checkup — models, KB index, components, egress. This is the
        # explicit home for every probe the quiet boot no longer runs on its
        # own (ARAIL_AUTOCHECKS default off). Pass --updates for the remote
        # update check (hybrid mode only); --strict promotes its own
        # optional findings (e.g. no model installed) to degraded too.
        if ! python -m arail.doctor "$@"; then
            warn "doctor checkup reported problems (see above)"
            _doctor_degraded=1
        fi

        if [[ "$_doctor_degraded" == "1" ]]; then
            warn "doctor: degraded"
            exit 3
        fi
        say "doctor: OK"
        ;;
    pkb)
        op="${1:-}"; shift || true
        case "$op" in
            ingest)  exec "$REPO_ROOT/scripts/pkb-ingest" "$@" ;;
            compile) exec "$REPO_ROOT/scripts/pkb-compile" "$@" ;;
            browse)  exec "$REPO_ROOT/scripts/pkb-browse" "$@" ;;
            *) die "pkb op must be one of: ingest | compile | browse" ;;
        esac
        ;;
    wiki)
        op="${1:-build}"; shift || true
        [[ -d .venv ]] || die "missing .venv — run ./arailctl setup"
        # shellcheck disable=SC1091
        source .venv/bin/activate
        case "$op" in
            build)
                exec python -m arail.wiki build --repo-root "$REPO_ROOT" "$@"
                ;;
            info)
                exec python -m arail.wiki info "$@"
                ;;
            serve)
                exec bash "$REPO_ROOT/scripts/start.sh"
                ;;
            new)
                title="${*:-untitled}"
                slug=$(python -c "from arail.wiki import slugify; import sys; print(slugify(sys.argv[1]))" "$title")
                dest="$REPO_ROOT/lab/pkb/notes/${slug}.md"
                if [[ -e "$dest" ]]; then die "already exists: $dest"; fi
                mkdir -p "$(dirname "$dest")"
                now=$(python -c "import datetime; print(datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%d'))")
                cat > "$dest" <<TEMPLATE
---
title: ${title}
section: notes
tags: []
aliases: []
created: ${now}
---

# ${title}

Write your page here. Link other pages with [[double-brackets]].
Tags inline with #hashtag are also picked up.
TEMPLATE
                say "created: $dest"
                ;;
            *) die "wiki op must be one of: build | info | new <title> | serve" ;;
        esac
        ;;
    world)
        [[ -d .venv ]] || die "missing .venv — run ./arailctl setup"
