#!/usr/bin/env python3
"""pkm-compile — Build the knowledge index.

Scans sources/, agents/, notes/, and inference/ to produce:
  - index.md  (full knowledge map with tags, stars, recents)
  - Updated stats for the portal dashboard
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from oglab.pkm import compile_index

BOLD = "\033[1m"
GREEN = "\033[0;32m"
CYAN = "\033[0;36m"
DIM = "\033[2m"
RESET = "\033[0m"


def main():
    print(f"\n{GREEN}⟨OGLab⟩{RESET} {BOLD}PKM Compile{RESET}\n")
    result = compile_index()

    total = result["total"]
    if total == 0:
        print(f"  {DIM}Knowledge base is empty. Add material to sources/ or set a goal.{RESET}")
        print(f"  {DIM}Tip: ./scripts/pkm-ingest to process your inbox{RESET}")
        return

    print(f"  {GREEN}✓{RESET} Indexed {total} item(s)")
    for section, count in result["sections"].items():
        if count:
            print(f"    {CYAN}•{RESET} {section}: {count}")

    if result["tags"]:
        tags = " ".join(f"#{t}" for t in result["tags"][:15])
        print(f"\n  {DIM}Tags: {tags}{RESET}")

    if result["starred"]:
        print(f"  {DIM}Starred: {result['starred']} item(s){RESET}")

    print(f"\n  → {result['index_path']}")
    print()


if __name__ == "__main__":
    main()
