# ARAIL's model defaults — the ONE file to check for what's active.
#
# Historically "which model does chat use by default" and "which model
# does AeroLLM (the 2nd inference / deep backend) load" were each
# answered by a chain of .env vars, hardcoded fallback constants, and
# installed-model detection spread across app.py and router/backends.py.
# Nobody could answer "what's actually active" without reading code —
# which is exactly how a machine ended up trying to load a 13GB model
# that was never downloaded, silently, on every chat page visit.
#
# This file replaces that scatter for these two settings specifically.
# Its values are stamped into the same environment variables every
# existing part of the codebase already reads (MODEL_NAME, AEROLLM_MODEL)
# — early, once, at process start — so they win over anything .env sets
# for these two keys. Copy this file to model_defaults.yaml (gitignored,
# like .env — it's per-machine) and edit it directly.

# default_a — the primary, fast, always-resident chat model
# (Chat Studio's Box A / "1st inference"). Must be an already-installed
# Ollama model tag (see `ollama list`).
default_a: llama-ai-eng

# default_b — the model AeroLLM (Box B / "2nd inference") loads. This is
# NOT an Ollama tag — it's a directory name under lab/models/ (or
# ARAIL_MODELS_DIR), holding real MLX-format weights AeroLLM can read.
# `./arailctl doctor` (or `ls lab/models/`) lists what's actually
# downloaded. Leave this null/commented until you've verified a specific
# model fits in memory on this machine alongside everything else you
# run — ARAIL will say "not ready" honestly rather than guess.
default_b: null
