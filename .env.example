# =============================================================================
# OGLab — AI Lab Blueprint Configuration
# =============================================================================
# Copy this file:  cp .env.example .env
# Then edit .env with your settings. (./oglab setup does this for you.)
#
# ─── SECRETS CHECKLIST ─────────────────────────────────────────────────────
#   • This file is a TEMPLATE. `./oglab setup` copies it to .env and fills
#     in the blanks (detected backend, generated passphrase, lab name, …).
#   • .env is in .gitignore — never force-add it.
#   • Never share your .env. The passphrase inside unlocks your IDE.
#   • To rotate the passphrase: `./oglab setup` and answer "new" when
#     asked about the existing passphrase.
# ───────────────────────────────────────────────────────────────────────────

# -----------------------------------------------------------------------------
# BRAND — make this lab your own.
# Every user-facing string (portal title, dashboard logo, activity log,
# status banner, wiki landing page) reads LAB_NAME at runtime. The Python
# package stays `oglab` so imports and the ./oglab CLI don't change, but
# everything the user *sees* can be rebranded with one .env edit.
# `./oglab setup` prompts for these on first run.
# -----------------------------------------------------------------------------
LAB_NAME=OGLab
LAB_SHORT_NAME=oglab
LAB_TAGLINE="AI Lab Blueprint"
# Optional — override the nav-bar glyph. Defaults to ⟨${LAB_NAME}⟩.
# LAB_LOGO="⟨OGLab⟩"

# -----------------------------------------------------------------------------
# MODE: "airgapped" (default) or "hybrid"
# airgapped = local models only, zero network calls
# hybrid    = local first, cloud fallback allowed
# -----------------------------------------------------------------------------
OGLAB_MODE=airgapped

# -----------------------------------------------------------------------------
# MODEL BACKEND
# `./oglab setup` detects your hardware and overwrites this line with the
# matching backend (mlx | cuda | cpu). Ships as "cpu" so a user who pokes
# at imports before running setup gets a working fallback, not a KeyError.
# Options: mlx | cuda | cpu | airllm | openai_compat | huggingface | openrouter | claude
# -----------------------------------------------------------------------------
MODEL_BACKEND=cpu

# Model to load (varies by backend)
# MLX:   mlx-community/Qwen3-8B-4bit
# CUDA:  Qwen/Qwen3-8B
# CPU:   Qwen/Qwen3-8B-GGUF  (quantized via llama.cpp)
MODEL_NAME=mlx-community/Qwen3-8B-4bit

# Local inference port (for vLLM / llama.cpp server)
LOCAL_API_PORT=8000

# -----------------------------------------------------------------------------
# OPENAI-COMPATIBLE SERVERS
# The same backend class ("openai_compat") fronts every service that speaks
# the OpenAI /v1/chat/completions protocol — local or hosted. Set
# MODEL_BACKEND=openai_compat and pick one of the presets below.
# -----------------------------------------------------------------------------
# — Local servers —
# MODEL_API_BASE=http://localhost:1234/v1             # LM Studio default
# MODEL_API_BASE=http://localhost:11434/v1            # Ollama default
# MODEL_API_KEY=not-needed                            # Local servers ignore this
#
# — NVIDIA NIM (build.nvidia.com) —
# Free credits on sign-up; OpenAI-compatible. Browse models at build.nvidia.com
# and grab an nvapi-xxx key. Great for trying Llama 3.3 70B, Nemotron, or
# DeepSeek-R1 before committing to a paid tier.
# MODEL_API_BASE=https://integrate.api.nvidia.com/v1
# MODEL_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MODEL_NAME=meta/llama-3.3-70b-instruct              # or nvidia/llama-3.3-nemotron-super-49b-v1
#
# — Browser Agent (agent-browser chat) —
# Auto-derived from MODEL_API_BASE and MODEL_API_KEY above.
# Override only if you want the browser agent to use a different model.
# AI_GATEWAY_API_KEY=not-needed
# AI_GATEWAY_URL=http://localhost:1234

# -----------------------------------------------------------------------------
# CLOUD BACKENDS (only used when OGLAB_MODE=hybrid)
# Each key below activates a dedicated backend class. NVIDIA NIM uses the
# openai_compat backend above — no separate class needed.
# -----------------------------------------------------------------------------
# HUGGINGFACE_API_KEY=hf_xxxxx
# OPENROUTER_API_KEY=sk-or-xxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# -----------------------------------------------------------------------------
# PATHS — runtime state lives under ./lab/ by default.
# Override any of these to split state across disks.
# -----------------------------------------------------------------------------
# LAB_ROOT=./lab                        # parent of data/, models/, pkb/
# OGLAB_DATA_DIR=./lab/data             # activity log, goals, experiments, consent
# OGLAB_MODELS_DIR=./lab/models         # downloaded model weights
# LAB_PKB=./lab/pkb                     # knowledge base (inbox, sources, notes)
# OGLAB_EXPERIMENTS_DIR=./lab/data/experiments

# -----------------------------------------------------------------------------
# AGENT INTENT — selects the researcher's domain context (ai, farming, ml,
# business, education, health, culinary). Set by `./oglab setup`.
# -----------------------------------------------------------------------------
# LAB_INTENT=ai
# LAB_INTENT_NAME="AI Engineer"

# -----------------------------------------------------------------------------
# LAB THEME — the lab's north-star research area. Appears in the
# dashboard Mission Objective card as permanent context above whatever
# specific goal is active. Swap it to reframe the whole lab's focus.
#
# Default theme: make SSD-hosted model inference faster. AirLLM is
# the reference implementation — every experiment either improves
# its throughput, reduces its memory footprint, or extends what
# models it can host.
# -----------------------------------------------------------------------------
LAB_THEME="Making SSD-hosted model inference faster — frontier open-weight models on laptop hardware"

# -----------------------------------------------------------------------------
# SCHEDULER — when the lab does light vs heavy work.
#   active hours → SLM only, stays responsive for interactive use
#   heavy  hours → AirLLM experiments + full GPU burn
# Ranges are 24h local time. Heavy takes precedence when ranges overlap.
# LAB_STARTUP_DELAY_SEC is the courtesy delay on boot before the researcher's
# first tick, so the UI loads clean before agents start working.
# Set by `./oglab setup` — uncomment + edit here to override.
# -----------------------------------------------------------------------------
LAB_ACTIVE_HOURS=08:00-22:00
LAB_HEAVY_HOURS=22:00-08:00
LAB_STARTUP_DELAY_SEC=300

# -----------------------------------------------------------------------------
# WIKI — documentation-as-code auto-rebuild behavior.
#
# The researcher agent and dashboard can trigger wiki recompiles. Agents
# typically fire several PKB writes in a row during a run, so rebuilds
# are debounced: the first request schedules a task, subsequent requests
# reset the timer, and the actual compile happens once the agent quiets
# down for LAB_WIKI_REBUILD_DEBOUNCE_SEC seconds.
#
# Set LAB_WIKI_AUTO_REBUILD=false to disable auto-rebuilds entirely — the
# wiki only refreshes when you click Rebuild on the dashboard or run
# `./oglab wiki build` manually.
# -----------------------------------------------------------------------------
LAB_WIKI_AUTO_REBUILD=true
LAB_WIKI_REBUILD_DEBOUNCE_SEC=30

# -----------------------------------------------------------------------------
# AIRLLM — frontier models, layer-streamed from disk
#
# AirLLM loads one transformer block at a time: the model never
# fully resides in RAM. That's how a MacBook chats with a 235B+
# model. Throughput is tokens-per-minute at that scale, not per-
# second — but the model itself is frontier-class.
#
# Dashboard has a "Deep model" toggle on the chat card that routes
# one message through AirLLM without switching MODEL_BACKEND. Hover
# the FRONTIER chip in the chat card header for a Spec Sheet with
# strengths + benchmark comparisons (registry lives at
# src/oglab/model_specs.py — edit to add more models).
#
# Suggested models — pick one that fits your disk:
#
#   Qwen/Qwen3-235B-A22B       # ~120 GB @ 4-bit · MoE, very strong generalist
#   Qwen/Qwen3-32B             #  ~20 GB @ 4-bit · smaller but fast-on-AirLLM
#   meta-llama/Llama-3.1-70B   #  ~40 GB @ 4-bit · solid reasoning workhorse
#   meta-llama/Llama-3.1-405B  # ~230 GB @ 4-bit · dense flagship, expensive
#   deepseek-ai/DeepSeek-V3    # ~380 GB @ 4-bit · MoE, elite at code + math
#   deepseek-ai/DeepSeek-R1    # ~380 GB @ 4-bit · reasoning-tuned, shows work
#   THUDM/GLM-4.6              # ~200 GB @ 4-bit · declarative + great coder
#   THUDM/GLM-5.1              # check repo size · Zhipu's flagship line
#
# The Spec Sheet popover in the dashboard reads AIRLLM_MODEL to
# show the right entry.
# -----------------------------------------------------------------------------
AIRLLM_MODEL=Qwen/Qwen3-235B-A22B
AIRLLM_COMPRESSION=4bit       # Options: 4bit | 8bit | none
AIRLLM_MAX_LENGTH=512
AIRLLM_RESEARCH=true           # Auto-use AirLLM for deep research tasks

# Research fork — point this at a git URL to run your own AirLLM
# fork instead of the PyPI release. `./oglab setup` installs from
# whatever you set here. See docs/airllm-fork-guide.md for the
# fork recipe + suggested optimizations (layer prefetch, KV cache
# persistence, speculative decoding with the fast model).
# AIRLLM_PACKAGE=git+https://github.com/yourname/airllm@main

# -----------------------------------------------------------------------------
# COST TRACKING
# Simulates what equivalent cloud API calls would cost.
# Local energy cost = watts × time × rate.
# -----------------------------------------------------------------------------
ENERGY_RATE_KWH=0.13           # USD per kWh — US national average

# -----------------------------------------------------------------------------
# SERVICE PORTS (also configurable in lab.conf)
# -----------------------------------------------------------------------------
PORTAL_PORT=8080
TERMINAL_PORT=7681
NOTEBOOK_PORT=8888
IDE_PORT=8443

# -----------------------------------------------------------------------------
# UNIFIED PASSPHRASE
# One secret powering every login surface in the lab: code-server (IDE),
# Open Notebook's data encryption key, and any future auth proxy.
#
# ► Owned by `./oglab setup`. Do NOT hand-edit here.
# ► To rotate: `./oglab setup` and answer "new" when prompted.
# ► The generated value is echoed in the final setup banner so you don't
#   have to grep this file.
# -----------------------------------------------------------------------------
# OGLAB_PASSWORD=  (set by setup)

# -----------------------------------------------------------------------------
# ADD-ON SERVICES (opt-in, via compose/ overlays)
#   docker compose -f compose/marimo.yml up -d
#   docker compose -f compose/open-notebook.yml up -d
# -----------------------------------------------------------------------------
MARIMO_PORT=2718
OPEN_NOTEBOOK_PORT=8502
OPEN_NOTEBOOK_API_PORT=5055
# OPEN_NOTEBOOK_ENCRYPTION_KEY mirrors OGLAB_PASSWORD. Set by `./oglab setup`.
# OPEN_NOTEBOOK_ENCRYPTION_KEY=  (set by setup)
