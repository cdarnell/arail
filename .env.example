# =============================================================================
# OGLab — AI Lab Blueprint Configuration
# =============================================================================
# Copy this file:  cp .env.example .env
# Then edit .env with your settings.

# -----------------------------------------------------------------------------
# MODE: "airgapped" (default) or "hybrid"
# airgapped = local models only, zero network calls
# hybrid    = local first, cloud fallback allowed
# -----------------------------------------------------------------------------
OGLAB_MODE=airgapped

# -----------------------------------------------------------------------------
# MODEL BACKEND (auto-detected by setup.sh, but you can override)
# Options: mlx | cuda | cpu | huggingface | openrouter | claude
# -----------------------------------------------------------------------------
MODEL_BACKEND=auto

# Model to load (varies by backend)
# MLX:   mlx-community/Mistral-7B-Instruct-v0.3-4bit
# CUDA:  mistralai/Mistral-7B-Instruct-v0.2
# CPU:   mistralai/Mistral-7B-Instruct-v0.2  (quantized via llama.cpp)
MODEL_NAME=mlx-community/Mistral-7B-Instruct-v0.3-4bit

# Local inference port (for vLLM / llama.cpp server)
LOCAL_API_PORT=8000

# -----------------------------------------------------------------------------
# CLOUD BACKENDS (only used when OGLAB_MODE=hybrid)
# -----------------------------------------------------------------------------
# HUGGINGFACE_API_KEY=hf_xxxxx
# OPENROUTER_API_KEY=sk-or-xxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# -----------------------------------------------------------------------------
# PATHS
# -----------------------------------------------------------------------------
OGLAB_MODELS_DIR=./models
OGLAB_EXPERIMENTS_DIR=./experiments
